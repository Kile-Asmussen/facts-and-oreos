{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(README.md)",
      "Write(README.md)",
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)",
      "Edit(TODO.md)",
      "Write(TODO.md)",

      "Edit(slop/**/*)",
      "Write(slop/**/*)",

      "Write(**/*.lua)",
      "Edit(**/*.lua)",
      
      "Edit(.cargo/config.toml)",
      "Write(.cargo/config.toml)",
      "Edit(Cargo.toml)",
      "Write(Cargo.toml)",
      "Edit(build.rs)",
      "Write(build.rs)",
      "Edit(src/**/*.rs)",
      "Write(src/**/*.rs)",

      "Edit(mod-api/**/*.toml)",
      "Write(mod-api/**/*.toml)",
      "Edit(mod-api/**/*.rs)",
      "Write(mod-api/**/*.rs)",

      "Edit(flua-src/**/*.toml)",
      "Write(flua-src/**/*.toml)",
      "Edit(flua-src/**/*.rs)",
      "Write(flua-src/**/*.rs)",

      "Edit(flua-mlua-sys/**/*.toml)",
      "Write(flua-mlua-sys/**/*.toml)",
      "Edit(flua-mlua-sys/**/*.rs)",
      "Write(flua-mlua-sys/**/*.rs)",

      "Edit(mlua-sys-shim/**/*.toml)",
      "Write(mlua-sys-shim/**/*.toml)",
      "Edit(mlua-sys-shim/**/*.rs)",
      "Write(mlua-sys-shim/**/*.rs)",

      "Edit(factorio-mod-api-codegen/**/*.toml)",
      "Write(factorio-mod-api-codegen/**/*.toml)",
      "Edit(factorio-mod-api-codegen/**/*.rs)",
      "Write(factorio-mod-api-codegen/**/*.rs)",

      "Edit(factorio-mod-api-codegen-derive/**/*.toml)",
      "Write(factorio-mod-api-codegen-derive/**/*.toml)",
      "Edit(factorio-mod-api-codegen-derive/**/*.rs)",
      "Write(factorio-mod-api-codegen-derive/**/*.rs)",

      "Edit(.factorio/**)",
      "Write(.factorio/**)",

      "Bash",
      "Read",
      "WebFetch",
      "WebSearch",
      "LSP",
      "ToolSearch",
      "mcp__grep-glob__grep",
      "mcp__grep-glob__glob"
    ],
    "deny": [
      "Agent",
      "Write(.claude/*)",
      "Edit(.claude/*)",
      "Write(.claude/**/*)",
      "Edit(.claude/**/*)"
    ],
    "defaultMode": "dontAsk"
  },
  "enabledMcpjsonServers": [
    "grep-glob"
  ],
  "hooks": {
    "ConfigChange": [
      {
        "matcher": "project_settings|local_settings|user_settings",
        "hooks": [
          {
            "type": "command",
            "command": "fishing config-change"
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "fishing cwd-changed"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|WebFetch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "fishing pre-tool-use"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "fishing rotate-log"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  }
}
