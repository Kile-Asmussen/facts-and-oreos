{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(README.md)",
      "Write(README.md)",
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)",
      "Edit(TODO.md)",
      "Write(TODO.md)",
      "Edit(Cargo.toml)",
      "Edit(slop/**/*)",
      "Write(slop/**/*)",
      "Write(**/*.lua)",
      "Edit(**/*.lua)",
      "Edit(src/**/*.rs)",
      "Write(src/**/*.rs)",
      "Bash",
      "Read",
      "WebFetch",
      "WebSearch",
      "LSP",
      "ToolSearch",
      "mcp__grep-glob__grep",
      "mcp__grep-glob__glob"
    ],
    "deny": [
      "Agent",
      "Write(.claude/*)",
      "Edit(.claude/*)",
      "Write(.claude/**/*)",
      "Edit(.claude/**/*)"
    ],
    "defaultMode": "dontAsk"
  },
  "enabledMcpjsonServers": [
    "grep-glob"
  ],
  "hooks": {
    "ConfigChange": [
      {
        "matcher": "project_settings|local_settings|user_settings",
        "hooks": [
          {
            "type": "command",
            "command": "fishing config-change"
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "fishing cwd-changed"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|WebFetch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "fishing pre-tool-use"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "fishing rotate-log"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  }
}
